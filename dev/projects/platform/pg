#!/usr/bin/env bash
# The platform's local Postgres: whichever Docker container publishes port 54329. Gradle's
# startPostgres task creates it with a random name, so it is found by port, never by name.
#
#   pg start      start it and follow its log (the `db` task)
#   pg ready      exit 0 once it accepts connections
#   pg has-db X   exit 0 if database X exists
#   pg exists     exit 0 if the container exists, running or not
#   pg create-db X  start it if needed and create an empty database X
set -euo pipefail
PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"
PORT=54329

container() {
  local ids; ids=$(docker ps -aq 2>/dev/null) || return 1
  [[ -n "$ids" ]] || return 1
  # shellcheck disable=SC2086
  docker inspect --format '{{.Name}} {{json .HostConfig.PortBindings}}' $ids \
    | awk -v p="\"HostPort\":\"$PORT\"" 'index($0, p) { sub("^/", "", $1); print $1; found = 1; exit } END { exit !found }'
}

case "${1:-}" in
  start)
    docker info >/dev/null 2>&1 || { echo "Docker Desktop is not running: open it, or run dev doctor"; exit 1; }
    c=$(container) || { echo "There is no Postgres container on $PORT yet: run dev doctor"; exit 1; }
    docker start "$c" >/dev/null
    exec docker logs -f --tail 20 "$c" ;;
  ready)  c=$(container) && docker exec "$c" pg_isready -q -U postgres ;;
  has-db) c=$(container) && [[ "$(docker exec "$c" psql -U postgres -Atc "select 1 from pg_database where datname = '$2'")" == 1 ]] ;;
  exists) container >/dev/null ;;
  create-db)
    c=$(container) || { echo "There is no Postgres container on $PORT yet"; exit 1; }
    docker start "$c" >/dev/null
    for _ in {1..30}; do docker exec "$c" pg_isready -q -U postgres && break; sleep 1; done
    docker exec "$c" createdb -U postgres "$2" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
