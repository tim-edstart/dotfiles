# ~/.zshrc — managed by dotfiles (https://github.com/tim-edstart/dotfiles)
#
# Secrets & machine-specific credentials live in ~/.zshrc.local, which is
# NOT tracked by this repo. Copy zsh/zshrc.local.example to ~/.zshrc.local
# and fill it in. See README.

# --- Prompt: Powerlevel10k instant prompt (keep above anything that prints) ---
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Local, machine-specific config & secrets (gitignored) ---
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# --- PATH ---
export PATH="$HOME/bin:$PATH"

# --- pnpm ---
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# --- Google Cloud SDK ---
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# --- nvm ---
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- Aliases / functions ---
# tmux new-session named after the current directory
tnew() { tmux new-session -s "$(basename "$(pwd)")"; }

# --- Prompt: Powerlevel10k, configured in zsh/p10k.zsh (`p10k configure` rewrites it) ---
for p in /opt/homebrew/share/powerlevel10k /usr/local/share/powerlevel10k "$HOME/.local/share/powerlevel10k"; do
  [ -r "$p/powerlevel10k.zsh-theme" ] && { source "$p/powerlevel10k.zsh-theme"; break; }
done
[ -f "$HOME/.p10k.zsh" ] && source "$HOME/.p10k.zsh"
