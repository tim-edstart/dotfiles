#!/usr/bin/env bash
# Smoke-test Neovim and its plugins: load every plugin, open a file with treesitter on,
# run an fzf-lua picker, and fail on any error Neovim reports or logs.
# Run it after upgrading Neovim or plugins (bin/nvim-upgrade runs it for you).
set -uo pipefail

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/nvim.log"
OUT="$(mktemp -t nvim-check)"
SAMPLE="$HOME/.dotfiles/nvim/init.lua"
before=$(wc -l <"$LOG" 2>/dev/null || echo 0)

perl -e 'alarm 90; exec @ARGV' nvim --headless "$SAMPLE" -c "lua
  local out, errs = '$OUT', {}
  local function try(what, fn)
    local ok, err = pcall(fn)
    if not ok then table.insert(errs, what .. ': ' .. tostring(err)) end
  end
  try('load plugins', function()
    local lazy = require('lazy')
    lazy.load({ plugins = vim.tbl_keys(require('lazy.core.config').plugins), wait = true })
  end)
  vim.api.nvim_exec_autocmds('User', { pattern = 'VeryLazy' })
  try('treesitter', function() vim.treesitter.start(0, 'lua') end)
  try('fzf-lua picker', function() require('fzf-lua').blines() end)
  vim.wait(3000, function() return false end, 100)  -- let pickers and decoration providers draw
  try('redraw', function() vim.cmd('redraw!') end)
  vim.wait(500, function() return false end, 50)
  for _, line in ipairs(vim.split(vim.fn.execute('messages'), '\n')) do
    if line:match('E%d+:') or line:match('[Ee]rror') then table.insert(errs, 'message: ' .. line) end
  end
  vim.fn.writefile(errs, out)
" -c 'qa!' </dev/null >/dev/null 2>&1
status=$?

new_log=$(tail -n +"$((before + 1))" "$LOG" 2>/dev/null | grep -E '^ERR|Error' || true)
if [[ $status -ne 0 && ! -s "$OUT" ]]; then echo "nvim-check: Neovim exited with status $status (timeout or crash)" >>"$OUT"; fi
[[ -n "$new_log" ]] && printf 'log: %s\n' "$new_log" >>"$OUT"

if [[ -s "$OUT" ]]; then
  echo "nvim-check: FAILED ($(nvim --version | head -1))"
  sed 's/^/  /' "$OUT"
  rm -f "$OUT"
  exit 1
fi
rm -f "$OUT"
echo "nvim-check: OK ($(nvim --version | head -1))"
