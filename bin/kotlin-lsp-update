#!/usr/bin/env bash
# Installs or updates JetBrains' kotlin-lsp under ~/.local/share/kotlin-lsp.
# Its pre-alpha builds stop starting about a month after they are built (exit code 7,
# "This build of kotlin-server has expired"), so nvim runs this when the server dies
# on startup and, in the background, once the installed build is three weeks old.
#
#   kotlin-lsp-update           install the latest release unless it is already installed
#   kotlin-lsp-update --force   reinstall the latest release
set -euo pipefail

home=${KOTLIN_LSP_HOME:-$HOME/.local/share/kotlin-lsp}
force=${1:-}

case "$(uname -s)" in
  Darwin) ext=sit ;;
  Linux) ext=tar.gz ;;
  *) echo "kotlin-lsp-update: no standalone build is published for $(uname -s)" >&2; exit 2 ;;
esac
arch=$(uname -m)
[ "$(uname -s)" = Darwin ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ] && arch=arm64  # a Rosetta shell reports x86_64
case "$arch" in
  arm64 | aarch64) ;;
  *) echo "kotlin-lsp-update: only arm64 builds are published" >&2; exit 2 ;;
esac

releases=$(curl -fsS 'https://api.github.com/repos/Kotlin/kotlin-lsp/releases?per_page=10')
tag=$(jq -r '[.[] | select(.tag_name | startswith("kotlin-lsp/v"))][0].tag_name' <<<"$releases")
version=${tag#kotlin-lsp/v}
[ -n "$version" ] && [ "$version" != null ] || { echo "kotlin-lsp-update: no kotlin-lsp release found" >&2; exit 1; }
installed=$(sed 's/^[A-Z]*-//' "$home/build.txt" 2>/dev/null || true)
if [ "$installed" = "$version" ] && [ "$force" != --force ]; then
  echo "kotlin-lsp $version is already installed"
  exit 0
fi

archive="kotlin-server-$version-aarch64.$ext"
url=$(jq -r --arg tag "$tag" '.[] | select(.tag_name == $tag).body' <<<"$releases" | grep -o "https://[^ )]*/$archive" | head -1)
[ -n "$url" ] || { echo "kotlin-lsp-update: release $version has no $archive" >&2; exit 1; }

lock="$home.updating"
mkdir -p "$(dirname "$home")"
mkdir "$lock" 2>/dev/null || { echo "kotlin-lsp-update: another update is running ($lock exists)" >&2; exit 3; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/kotlin-lsp.XXXXXX")
trap 'rmdir "$lock" 2>/dev/null; rm -rf "$tmp"' EXIT

echo "downloading kotlin-lsp ${version}..."
curl -fsSL -o "$tmp/$archive" "$url"
curl -fsSL -o "$tmp/$archive.sha256" "$url.sha256"
expected=$(cut -d' ' -f1 "$tmp/$archive.sha256")
if command -v shasum >/dev/null; then actual=$(shasum -a 256 "$tmp/$archive" | cut -d' ' -f1); else actual=$(sha256sum "$tmp/$archive" | cut -d' ' -f1); fi
[ "$expected" = "$actual" ] || { echo "kotlin-lsp-update: checksum mismatch for $archive" >&2; exit 1; }

mkdir "$tmp/x"
case "$ext" in
  sit) unzip -q "$tmp/$archive" -d "$tmp/x" ;;
  tar.gz) tar -xzf "$tmp/$archive" -C "$tmp/x" ;;
esac
top=$(find "$tmp/x" -mindepth 1 -maxdepth 1 -type d | head -1)
[ -x "$top/bin/intellij-server" ] || chmod +x "$top/bin/intellij-server" 2>/dev/null || true
[ -f "$top/bin/intellij-server" ] || { echo "kotlin-lsp-update: $archive has no bin/intellij-server" >&2; exit 1; }
[ "$(uname -s)" = Darwin ] && xattr -dr com.apple.quarantine "$top" 2>/dev/null || true

rm -rf "$home.previous"
if [ -d "$home" ]; then
  mv "$home" "$home.previous"
  mv "$top" "$home"
  echo "installed kotlin-lsp $version (was ${installed:-unknown}); the previous build is at $home.previous"
else
  mv "$top" "$home"
  echo "installed kotlin-lsp $version"
fi
